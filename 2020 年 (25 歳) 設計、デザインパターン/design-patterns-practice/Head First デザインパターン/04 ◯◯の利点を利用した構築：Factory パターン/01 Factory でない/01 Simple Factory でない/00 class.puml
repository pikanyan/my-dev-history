@startuml not Factory

PizzaStore -> Pizza



class PizzaStore <<Creator>>
{
    + Pizza orderPizza(String type)
}

class Pizza <<Product>>
{
    + void prepare()
    + void bake()
    + void cut()
    + void box()
}

class CheesePizza extends Pizza
class ClamPizza
class GreekPizza
class PepperoniPizza
class VeggiePizza

CheesePizza --[hidden] ClamPizza
ClamPizza --[hidden] GreekPizza
GreekPizza --[hidden] PepperoniPizza
PepperoniPizza --[hidden] VeggiePizza

@enduml
